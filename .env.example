# Pocketbook environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# --- Plaid ---
# From the Plaid dashboard (https://dashboard.plaid.com). Use sandbox during development.
PLAID_CLIENT_ID=
PLAID_CLIENT_SECRET=
# One of: sandbox | development | production
PLAID_ENV=sandbox

# --- Token vault ---
# Symmetric key used to encrypt Plaid access tokens at rest in the DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A leaked DB file alone must NOT expose live bank connections — this key lives only here.
TOKEN_VAULT_KEY=

# --- Database ---
# Optional override for the SQLite file path. Defaults to a repo-local path if unset.
DB_PATH=./pocketbook.db

# --- API auth ---
# Shared token/secret required by API middleware. Worth setting even single-user if
# the app is network-accessible.
API_AUTH_TOKEN=
